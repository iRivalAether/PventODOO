<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- LISTA DE MOVIMIENTOS -->
    <!-- ========================================================= -->

    <record id="view_pvent_movement_tree" model="ir.ui.view">

        <field name="name">pvent.movement.tree</field>
        <field name="model">pvent.movement</field>

        <field name="arch" type="xml">

            <list string="Movimientos">

                <field name="name"/>
                <field name="movement_date"/>
                <field name="movement_type"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="project_id"/>
                <field name="responsible_id"/>
                <field name="state"/>

            </list>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- FORMULARIO DE MOVIMIENTO -->
    <!-- ========================================================= -->

    <record id="view_pvent_movement_form" model="ir.ui.view">

        <field name="name">pvent.movement.form</field>
        <field name="model">pvent.movement</field>

        <field name="arch" type="xml">

            <form string="Movimiento de inventario">

                <header>

                    <button name="action_confirm"
                            type="object"
                            string="Confirmar"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_reverse"
                            type="object"
                            string="Revertir"
                            invisible="state != 'confirmed'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed"/>

                </header>


                <sheet>

                    <!-- REFERENCIA -->

                    <div class="oe_title">

                        <h1>

                            <field name="name"
                                   readonly="1"/>

                        </h1>

                    </div>


                    <!-- INFORMACIÓN PRINCIPAL -->

                    <group>

                        <group>

                            <field name="movement_date"/>
                            <field name="movement_type"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>

                        </group>


                        <group>

                            <field name="source_location_id"/>
                            <field name="destination_location_id"/>
                            <field name="project_id"/>
                            <field name="responsible_id"/>

                        </group>

                    </group>


                    <!-- OBSERVACIONES -->

                    <group string="Observaciones">

                        <field name="notes"
                               placeholder="Escriba observaciones del movimiento..."/>

                    </group>


                    <!-- INFORMACIÓN DE CONFIRMACIÓN -->

                    <group string="Confirmación">

                        <field name="confirmed_by"
                               readonly="1"/>

                        <field name="confirmed_at"
                               readonly="1"/>

                    </group>


                    <!-- REVERSIÓN -->

                    <group string="Reversión"
                           invisible="not reversal_of_id">

                        <field name="reversal_of_id"
                               readonly="1"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ========================================================= -->
    <!-- ACCIÓN DE MOVIMIENTOS -->
    <!-- ========================================================= -->

    <record id="action_pvent_movements"
            model="ir.actions.act_window">

        <field name="name">Movimientos</field>

        <field name="res_model">pvent.movement</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>